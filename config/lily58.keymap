#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

&lt { quick-tap-ms = <175>; };

/ {
    behaviors {
        hrm_right_index: hrm_right_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_RIGHT_INDEX";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 43 50 51 52 53 54>;
        };

        hrm_left_index: hrm_left_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_LEFT_INDEX";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 48 49 53 54 55 56 57>;
        };

        hrm_left_mid: hrm_left_mid {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_LEFT_MID";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 48 49 53 54 55 56 57>;
        };

        hrm_right_mid: hrm_right_mid {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_RIGHT_MID";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 43 50 51 52 53 54>;
        };

        hrm_left_ring: hrm_left_ring {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <240>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_LEFT_RING";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 48 49 53 54 55 56 57>;
        };

        hrm_right_ring: hrm_right_ring {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <240>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_RIGHT_RING";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 43 50 51 52 53 54>;
        };

        hrm_left_pink: hrm_left_pink {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_LEFT_PINK";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 48 49 53 54 55 56 57>;
        };

        hrm_right_pink: hrm_right_pink {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_RIGHT_PINK";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 43 50 51 52 53 54>;
        };

        thumb_layer_access: thumb_layer_access {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            label = "THUMB_LAYER_ACCESS";
        };
    };

    combos {
        compatible = "zmk,combos";

        caps_word_index {
            bindings = <&caps_word>;
            key-positions = <28 31>;
        };

        caps_lock {
            bindings = <&kp CLCK>;
            key-positions = <49 36>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE        &kp N1                 &kp N2                 &kp N3                 &kp N4                   &kp N5                                                                                     &kp N6                       &kp N7                    &kp N8                  &kp N9                  &kp N0                     &lt 4 MINUS
&kp TAB          &kp Q                  &kp W                  &kp E                  &kp R                    &kp T                                                                                      &kp Y                        &kp U                     &kp I                   &kp O                   &kp P                      &kp BSLH
&kp ESCAPE       &hrm_left_pink LGUI A  &hrm_left_ring LALT S  &hrm_left_mid LCTRL D  &hrm_left_index LSHFT F  &kp G                                                                                      &kp H                        &hrm_right_index RSHFT J  &hrm_right_mid RCTRL K  &hrm_right_ring RALT L  &hrm_right_pink LGUI SEMI  &kp SQT
&mt LSHFT EQUAL  &kp Z                  &kp X                  &kp C                  &kp V                    &kp B                            &kp ENTER                    &kp BACKSPACE                &kp N                        &kp M                     &kp COMMA               &kp DOT                 &kp FSLH                   &mt RIGHT_SHIFT EQUAL
                                                               &kp LEFT_BRACKET       &kp RIGHT_BRACKET        &thumb_layer_access 2 BACKSPACE  &thumb_layer_access 3 DEL    &thumb_layer_access 3 ENTER  &thumb_layer_access 1 SPACE  &kp LEFT_ARROW            &kp RIGHT_ARROW
            >;
        };

        symbols {
            display-name = "Lower";
            bindings = <
&kp GRAVE  &kp PERIOD      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMI           &kp COMMA                              &trans  &trans         &trans       &trans     &trans        &trans
&kp EXCL   &kp LEFT_BRACE  &kp LPAR          &kp RPAR           &kp RBRC           &kp QMARK                              &none   &kp LSHFT      &kp LCTRL    &kp LALT   &kp LEFT_GUI  &none
&kp HASH   &kp CARET       &kp EQUAL         &kp MINUS          &kp DOLLAR         &kp STAR                               &none   &kp BACKSPACE  &kp TAB      &kp SPACE  &kp ENTER     &trans
&kp TILDE  &kp LT          &kp PIPE          &kp UNDER          &kp GT             &kp SLASH    &kp SEMICOLON    &kp DOT  &none   &kp DEL        &kp LS(TAB)  &none      &none         &trans
                                             &kp LS(LBKT)       &kp DOUBLE_QUOTES  &kp PERCENT  &kp COLON        &trans   &trans  &trans         &trans
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
&trans  &none         &none     &none             &none           &none                        &kp TILDE    &kp CARET     &kp SLASH     &kp ASTERISK  &kp MINUS      &kp ENTER
&trans  &none         &none     &none             &none           &none                        &kp PERCENT  &kp N7        &kp N8        &kp N9        &kp LS(EQUAL)  &kp TAB
&trans  &kp LEFT_GUI  &kp LALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none                        &kp PLUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COLON      &kp LS(TAB)
&none   &none         &none     &none             &none           &none  &trans    &trans      &kp ASTRK    &kp N1        &kp N2        &kp N3        &kp SLASH      &kp ENTER
                                &none             &none           &none  &none     &kp PERIOD  &kp N0       &kp COMMA     &kp PERIOD
            >;
        };

        navigation {
            display-name = "Raise";
            bindings = <
&kp F1  &kp F2    &kp F3        &kp F4     &kp F5     &kp F6                    &kp F7    &kp F8           &kp F9             &kp F10        &kp F11   &kp F12
&trans  &trans    &trans        &trans     &trans     &trans                    &trans    &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RGUI  &kp RC(PSCRN)
&trans  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &trans                    &kp LEFT  &kp DOWN_ARROW   &kp UP_ARROW       &kp RIGHT      &none     &kp SCROLLLOCK
&trans  &trans    &trans        &trans     &trans     &trans  &trans    &trans  &none     &kp HOME         &kp PG_UP          &kp PAGE_DOWN  &kp END   &kp PAUSE_BREAK
                                &trans     &trans     &trans  &trans    &trans  &trans    &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        system_layer {
            bindings = <
&bt BT_CLR        &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &studio_unlock  &trans
&ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans          &trans
&trans            &trans             &trans             &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans          &trans
&trans            &trans             &trans             &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans          &trans
                                                        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
